#!/usr/bin/env bash

# Colors for better UI
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Function to convert string to lowercase (bash 3.2 compatible)
to_lowercase() {
    echo "$1" | tr '[:upper:]' '[:lower:]'
}

# Function to convert string to uppercase (bash 3.2 compatible)
to_uppercase() {
    echo "$1" | tr '[:lower:]' '[:upper:]'
}

# Function to display usage
show_usage() {
    cat << EOF
Usage: $0 [company_name] [environment_name]

AWS SSO Profile Manager (macOS Compatible)

Commands:
  $0                     # Interactive mode - choose company first, then environment
  $0 sbc                 # Direct mode - go to environment selection for 'sbc'
  $0 sbc sit             # Jump directly to profile details for 'sbc_sit'
  $0 mycompany dev       # Jump directly to profile details for 'mycompany_dev'

Options:
  -h, --help             Show this help message
  -c, --companies        Show available companies only
  -a, --accounts         Show all account IDs and mappings

Examples:
  $0                     # Choose company first, then environment
  $0 sbc                 # Skip to environment selection for 'sbc' company
  $0 sbc sit             # Go directly to 'sbc_sit' profile details
  $0 techcorp prod       # Go directly to 'techcorp_prod' profile details
  $0 -c                  # List all available companies
  $0 -a                  # Show account mappings

Default config location: ${HOME}/.aws/config

Note: Company and environment names are case-insensitive. If the profile doesn't exist,
      you'll see an error and available options will be displayed.

EOF
}

# Function to check if a company exists in config file (case-insensitive)
company_exists() {
    local company="$1"
    local config_file="${2:-${HOME}/.aws/config}"
    
    if [[ ! -f "$config_file" ]]; then
        return 1
    fi
    
    # Convert input company to lowercase for comparison
    local company_lower
    company_lower=$(to_lowercase "$company")
    
    # Check if any profile starts with company_ (case-insensitive)
    while IFS= read -r line; do
        if [[ $line =~ ^\[profile[[:space:]]+([^]]+)\] ]]; then
            profile_name="${BASH_REMATCH[1]}"
            
            # Skip default profile
            if [[ "$profile_name" == "default" ]]; then
                continue
            fi
            
            # Extract company part and convert to lowercase
            if [[ $profile_name =~ ^([^_-]+)[_-] ]]; then
                profile_company="${BASH_REMATCH[1]}"
                profile_company_lower=$(to_lowercase "$profile_company")
                
                # Case-insensitive comparison
                if [[ "$profile_company_lower" == "$company_lower" ]]; then
                    # Return the actual company name from config (preserve case)
                    echo "$profile_company"
                    return 0
                fi
            fi
        fi
    done < "$config_file"
    
    return 1
}

# Function to check if a specific profile exists (case-insensitive)
profile_exists() {
    local company="$1"
    local environment="$2"
    local config_file="${3:-${HOME}/.aws/config}"
    
    if [[ ! -f "$config_file" ]]; then
        return 1
    fi
    
    # Convert inputs to lowercase for comparison
    local company_lower environment_lower
    company_lower=$(to_lowercase "$company")
    environment_lower=$(to_lowercase "$environment")
    
    # Check if profile exists (case-insensitive)
    while IFS= read -r line; do
        if [[ $line =~ ^\[profile[[:space:]]+([^]]+)\] ]]; then
            profile_name="${BASH_REMATCH[1]}"
            
            # Check if profile matches company_environment pattern (case-insensitive)
            if [[ $profile_name =~ ^([^_-]+)[_-](.+)$ ]]; then
                profile_company="${BASH_REMATCH[1]}"
                profile_env="${BASH_REMATCH[2]}"
                
                profile_company_lower=$(to_lowercase "$profile_company")
                profile_env_lower=$(to_lowercase "$profile_env")
                
                # Case-insensitive comparison
                if [[ "$profile_company_lower" == "$company_lower" ]] && [[ "$profile_env_lower" == "$environment_lower" ]]; then
                    # Return the actual profile name from config (preserve case)
                    echo "$profile_name"
                    return 0
                fi
            fi
        fi
    done < "$config_file"
    
    return 1
}

# Function to get available companies dynamically
get_companies() {
    local config_file="${1:-${HOME}/.aws/config}"
    
    if [[ ! -f "$config_file" ]]; then
        echo "Config file not found: $config_file" >&2
        return 1
    fi
    
    # Use a temporary approach to track companies and counts
    local companies_temp
    companies_temp=$(mktemp -t aws_companies.XXXXXX)
    
    while IFS= read -r line; do
        if [[ $line =~ ^\[profile[[:space:]]+([^]]+)\] ]]; then
            profile_name="${BASH_REMATCH[1]}"
            
            # Skip default profile
            if [[ "$profile_name" == "default" ]]; then
                continue
            fi
            
            # Extract company name (everything before first underscore or dash)
            if [[ $profile_name =~ ^([^_-]+)[_-] ]]; then
                company="${BASH_REMATCH[1]}"
                echo "$company" >> "$companies_temp"
            fi
        fi
    done < "$config_file"
    
    # Count and output companies (macOS compatible)
    if [[ -f "$companies_temp" && -s "$companies_temp" ]]; then
        sort "$companies_temp" | uniq -c | while read -r count company; do
            # Remove leading spaces from count (macOS uniq behavior)
            count=$(echo "$count" | tr -d ' ')
            echo "$company:$count"
        done
        rm -f "$companies_temp"
    else
        rm -f "$companies_temp"
    fi
}

# Function to get available environments for a company dynamically
get_environments() {
    local company="$1"
    local config_file="${2:-${HOME}/.aws/config}"
    
    local environments_temp
    environments_temp=$(mktemp -t aws_environments.XXXXXX)
    
    while IFS= read -r line; do
        if [[ $line =~ ^\[profile[[:space:]]+([^]]+)\] ]]; then
            profile_name="${BASH_REMATCH[1]}"
            
            # Check if profile matches company pattern and extract environment
            if [[ $profile_name =~ ^${company}[_-](.+)$ ]]; then
                env="${BASH_REMATCH[1]}"
                echo "$env" >> "$environments_temp"
            fi
        fi
    done < "$config_file"
    
    # Output environments sorted
    if [[ -f "$environments_temp" && -s "$environments_temp" ]]; then
        sort -u "$environments_temp"
        rm -f "$environments_temp"
    else
        rm -f "$environments_temp"
    fi
}

# Function to get environment icon dynamically
get_env_icon() {
    local env="$1"
    local env_lower
    env_lower=$(to_lowercase "$env")
    
    case "$env_lower" in
        dev|development) echo "🔧" ;;
        sit|staging|test|testing) echo "🧪" ;;
        prod|production|prd) echo "🚀" ;;
        uat|user*) echo "👥" ;;
        qa|quality*) echo "🔍" ;;
        demo|sandbox) echo "🏖️" ;;
        int|integration) echo "🔗" ;;
        perf|performance) echo "⚡" ;;
        dr|disaster*) echo "🆘" ;;
        *) echo "📦" ;;
    esac
}

# Function to get account ID for a profile
get_account_id() {
    local profile="$1"
    local config_file="${2:-${HOME}/.aws/config}"
    
    local in_profile=false
    
    while IFS= read -r line; do
        if [[ $line =~ ^\[profile[[:space:]]+$profile\] ]]; then
            in_profile=true
        elif [[ $line =~ ^\[ ]]; then
            in_profile=false
        elif [[ $in_profile == true ]] && [[ $line =~ ^sso_account_id[[:space:]]*=[[:space:]]*(.+)$ ]]; then
            echo "${BASH_REMATCH[1]// /}"
            return 0
        fi
    done < "$config_file"
}

# Function to show account mappings
show_account_mappings() {
    local config_file="${1:-${HOME}/.aws/config}"
    
    echo -e "${CYAN}╔════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║        AWS Account Mappings        ║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${BLUE}📁 Config: ${config_file}${NC}"
    echo ""
    
    # Get companies list
    company_list=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && company_list+=("$line")
    done < <(get_companies "$config_file")
    
    if [[ ${#company_list[@]} -eq 0 ]]; then
        echo -e "${RED}❌ No companies found in config file${NC}"
        return 1
    fi
    
    for company_info in "${company_list[@]}"; do
        IFS=':' read -r company count <<< "$company_info"
        company_upper=$(to_uppercase "$company")
        echo -e "${BLUE}🏢 ${company_upper}:${NC}"
        
        # Get environments for this company
        env_list=()
        while IFS= read -r line; do
            [[ -n "$line" ]] && env_list+=("$line")
        done < <(get_environments "$company" "$config_file")
        
        for env in "${env_list[@]}"; do
            profile="${company}_${env}"
            account_id=$(get_account_id "$profile" "$config_file")
            env_emoji=$(get_env_icon "$env")
            env_upper=$(to_uppercase "$env")
            
            if [[ -n "$account_id" ]]; then
                printf "  ${env_emoji} %-12s ${GREEN}%s${NC}\n" "${env_upper}" "$account_id"
            else
                printf "  ${env_emoji} %-12s ${RED}No Account ID${NC}\n" "${env_upper}"
            fi
        done
        echo ""
    done
}

