# Function to show company not found error with suggestions
show_company_not_found() {
    local requested_company="$1"
    local config_file="${2:-${HOME}/.aws/config}"
    
    echo -e "${RED}❌ Company '${requested_company}' not found in config file${NC}"
    echo ""
    echo -e "${YELLOW}💡 Available companies:${NC}"
    
    # Get companies list
    company_list=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && company_list+=("$line")
    done < <(get_companies "$config_file")
    
    if [[ ${#company_list[@]} -eq 0 ]]; then
        echo -e "${RED}   No companies found in config file${NC}"
        echo -e "${YELLOW}   Make sure your profiles follow the pattern: company_environment${NC}"
    else
        for company_info in "${company_list[@]}"; do
            IFS=':' read -r company count <<< "$company_info"
            company_upper=$(to_uppercase "$company")
            echo -e "${GREEN}   • ${company_upper}${NC} (${count} profile$([ $count -ne 1 ] && echo 's' || echo ''))"
        done
    fi
    
    echo ""
    echo -e "${CYAN}Usage examples:${NC}"
    for company_info in "${company_list[@]}"; do
        IFS=':' read -r company count <<< "$company_info"
        echo -e "${BLUE}  aws_profile ${company}${NC}"
        echo -e "${BLUE}  aws_profile ${company} dev${NC}"
    done
    echo ""
}

# Function to show environment not found error with suggestions
show_environment_not_found() {
    local company="$1"
    local requested_env="$2"
    local config_file="${3:-${HOME}/.aws/config}"
    
    company_upper=$(to_uppercase "$company")
    echo -e "${RED}❌ Environment '${requested_env}' not found for company '${company_upper}'${NC}"
    echo ""
    echo -e "${YELLOW}💡 Available environments for ${company_upper}:${NC}"
    
    # Get environments for this company
    env_list=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && env_list+=("$line")
    done < <(get_environments "$company" "$config_file")
    
    if [[ ${#env_list[@]} -eq 0 ]]; then
        echo -e "${RED}   No environments found for company: ${company}${NC}"
        echo -e "${YELLOW}   Make sure your profiles follow the pattern: ${company}_environment${NC}"
    else
        for env in "${env_list[@]}"; do
            env_emoji=$(get_env_icon "$env")
            env_upper=$(to_uppercase "$env")
            echo -e "${GREEN}   • ${env_emoji} ${env_upper}${NC}"
        done
    fi
    
    echo ""
    echo -e "${CYAN}Usage examples:${NC}"
    for env in "${env_list[@]}"; do
        echo -e "${BLUE}  aws_profile ${company} ${env}${NC}"
    done
    echo ""
}

# Main function - handles 0, 1, or 2 arguments
main() {
    local company_param="$1"
    local environment_param="$2"
    local config_file="${HOME}/.aws/config"
    
    # Check if config file exists
    if [[ ! -f "$config_file" ]]; then
        echo -e "${RED}❌ Config file not found: $config_file${NC}"
        echo "Please check the path or create an AWS config file first."
        echo ""
        echo -e "${YELLOW}💡 Expected SSO format:${NC}"
        echo -e "${GREEN}[profile company_environment]${NC}"
        echo -e "${GREEN}sso_start_url = https://...${NC}"
        echo -e "${GREEN}sso_region = ap-southeast-1${NC}"
        echo -e "${GREEN}sso_account_id = 123456789012${NC}"
        echo -e "${GREEN}sso_role_name = role-name${NC}"
        echo -e "${GREEN}output = json${NC}"
        echo ""
        echo -e "${BLUE}🍎 macOS AWS CLI Setup:${NC}"
        echo -e "${GREEN}  # Install AWS CLI (if not installed):${NC}"
        echo -e "${GREEN}  brew install awscli${NC}"
        echo -e "${GREEN}  # Or download from: https://aws.amazon.com/cli/${NC}"
        return 1
    fi
    
    # Case 1: No arguments -> Show company selection menu
    if [[ -z "$company_param" ]]; then
        show_company_menu "$config_file"
        return 0
    fi
    
    # Case 2: Only company specified -> Show environment selection
    if [[ -n "$company_param" && -z "$environment_param" ]]; then
        local actual_company
        actual_company=$(company_exists "$company_param" "$config_file")
        local exists_result=$?
        
        if [[ $exists_result -eq 0 && -n "$actual_company" ]]; then
            # Company exists - go directly to environment selection
            show_environment_menu "$actual_company" "$config_file"
        else
            # Company doesn't exist - show error and available companies
            show_company_not_found "$company_param" "$config_file"
            return 1
        fi
        return 0
    fi
    
    # Case 3: Both company and environment specified -> Go directly to profile details
    if [[ -n "$company_param" && -n "$environment_param" ]]; then
        local actual_profile
        actual_profile=$(profile_exists "$company_param" "$environment_param" "$config_file")
        local profile_exists_result=$?
        
        if [[ $profile_exists_result -eq 0 && -n "$actual_profile" ]]; then
            # Profile exists - extract the actual company and environment names from the profile
            if [[ $actual_profile =~ ^([^_-]+)[_-](.+)$ ]]; then
                actual_company="${BASH_REMATCH[1]}"
                actual_environment="${BASH_REMATCH[2]}"
                show_profile_details "$actual_company" "$actual_environment" "$actual_profile" "$config_file"
            else
                echo -e "${RED}❌ Invalid profile format: $actual_profile${NC}"
                return 1
            fi
        else
            # Profile doesn't exist - check if company exists first
            local actual_company
            actual_company=$(company_exists "$company_param" "$config_file")
            local company_exists_result=$?
            
            if [[ $company_exists_result -eq 0 && -n "$actual_company" ]]; then
                # Company exists but environment doesn't
                show_environment_not_found "$actual_company" "$environment_param" "$config_file"
            else
                # Company doesn't exist
                show_company_not_found "$company_param" "$config_file"
            fi
            return 1
        fi
        return 0
    fi
}

# Handle command line arguments
case "${1:-}" in
    -h|--help)
        show_usage
        exit 0
        ;;
    -c|--companies)
        show_companies_only "${HOME}/.aws/config"
        exit 0
        ;;
    -a|--accounts)
        show_account_mappings "${HOME}/.aws/config"
        exit 0
        ;;
    *)
        main "$1" "$2"
        ;;
esac
