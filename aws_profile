# Function to clear screen (macOS compatible)
clear_screen() {
    if command -v clear >/dev/null 2>&1; then
        clear
    else
        printf '\033[2J\033[H'
    fi
}

# Function to display company selection menu
show_company_menu() {
    local config_file="${1:-${HOME}/.aws/config}"
    
    clear_screen
    echo -e "${CYAN}╔════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║    AWS SSO Profile Manager    ║${NC}"
    echo -e "${CYAN}║         macOS Compatible           ║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${BLUE}📁 Config: ${config_file}${NC}"
    echo ""
    echo -e "${YELLOW}🏢 Step 1: Select Company${NC}"
    echo ""
    
    # Check if config file exists
    if [[ ! -f "$config_file" ]]; then
        echo -e "${RED}❌ Config file not found: $config_file${NC}"
        echo -e "${YELLOW}💡 Please create the config file first or check the path${NC}"
        echo -e "${BLUE}🔧 Expected format:${NC}"
        echo -e "${GREEN}[profile company_environment]${NC}"
        echo -e "${GREEN}sso_start_url = https://...${NC}"
        echo -e "${GREEN}sso_region = ap-southeast-1${NC}"
        echo -e "${GREEN}sso_account_id = 123456789012${NC}"
        echo -e "${GREEN}sso_role_name = role-name${NC}"
        echo -e "${GREEN}output = json${NC}"
        return 1
    fi
    
    # Get companies and store in array
    company_list=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && company_list+=("$line")
    done < <(get_companies "$config_file")
    
    if [[ ${#company_list[@]} -eq 0 ]]; then
        echo -e "${RED}❌ No companies found in AWS config file${NC}"
        echo -e "${YELLOW}💡 Make sure your profiles follow the pattern: company_environment${NC}"
        echo -e "${YELLOW}📍 Looking in: $config_file${NC}"
        return 1
    fi
    
    # Display menu
    local i=1
    # Store menu mappings in a temporary file (macOS compatible)
    local menu_temp
    menu_temp=$(mktemp -t aws_menu.XXXXXX)
    
    echo -e "${BLUE}Available Companies:${NC}"
    for company_info in "${company_list[@]}"; do
        IFS=':' read -r company count <<< "$company_info"
        
        # Get sample environments for preview (limit to 3)
        env_sample=()
        local env_count=0
        while IFS= read -r line && [[ $env_count -lt 3 ]]; do
            if [[ -n "$line" ]]; then
                env_sample+=("$line")
                ((env_count++))
            fi
        done < <(get_environments "$company" "$config_file")
        
        env_preview=""
        for env in "${env_sample[@]}"; do
            icon=$(get_env_icon "$env")
            env_preview+="$icon$env "
        done
        
        # Check if there are more environments (macOS compatible wc)
        total_envs=$(get_environments "$company" "$config_file" | wc -l | tr -d ' ')
        if [[ $total_envs -gt 3 ]]; then
            env_preview+="..."
        fi
        
        company_upper=$(to_uppercase "$company")
        printf "${GREEN}%2d)${NC} ${BLUE}%-12s${NC} ${MAGENTA}(%d profile%s)${NC} ${YELLOW}%s${NC}\n" \
            "$i" "${company_upper}" "$count" "$([ $count -ne 1 ] && echo 's' || echo '')" "$env_preview"
        
        # Store mapping in temp file
        echo "$i:$company" >> "$menu_temp"
        ((i++))
    done
    
    echo ""
    echo -e "${CYAN}💡 Tip: Use ${BOLD}aws_profile COMPANY${NC}${CYAN} or ${BOLD}aws_profile COMPANY ENV${NC}${CYAN} for faster access${NC}"
    echo ""
    printf "${GREEN}%2s)${NC} ${CYAN}%-12s${NC}\n" "a" "Account Mappings"
    printf "${GREEN}%2s)${NC} ${RED}%-12s${NC}\n" "q" "Quit"
    echo ""
    
    # Get user selection
    while true; do
        echo -n -e "${YELLOW}👉 Enter your choice [1-$((i-1)), a, or q]: ${NC}"
        read -r choice
        
        if [[ "$choice" == "q" || "$choice" == "Q" ]]; then
            rm -f "$menu_temp"
            echo "👋 Goodbye!"
            return 0
        elif [[ "$choice" == "a" || "$choice" == "A" ]]; then
            show_account_mappings "$config_file"
            echo ""
            echo -n -e "${YELLOW}Press Enter to continue...${NC}"
            read -r
            rm -f "$menu_temp"
            show_company_menu "$config_file"
            return 0
        elif [[ "$choice" =~ ^[0-9]+$ ]] && [[ $choice -ge 1 ]] && [[ $choice -lt $i ]]; then
            # Get company from temp file
            selected_company=$(grep "^$choice:" "$menu_temp" | cut -d: -f2)
            rm -f "$menu_temp"
            if [[ -n "$selected_company" ]]; then
                show_environment_menu "$selected_company" "$config_file"
                return 0
            fi
        else
            echo -e "${RED}❌ Invalid choice. Please try again.${NC}"
        fi
    done
}

# Function to display environment selection menu
show_environment_menu() {
    local company="$1"
    local config_file="${2:-${HOME}/.aws/config}"
    
    clear_screen
    echo -e "${CYAN}╔════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║    AWS SSO Profile Manager    ║${NC}"
    echo -e "${CYAN}║         macOS Compatible           ║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════╝${NC}"
    echo ""
    
    company_upper=$(to_uppercase "$company")
    echo -e "${BLUE}🏢 Selected Company: ${company_upper}${NC}"
    echo ""
    echo -e "${YELLOW}🌍 Step 2: Select Environment${NC}"
    echo ""
    
    # Get environments and store in array
    env_list=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && env_list+=("$line")
    done < <(get_environments "$company" "$config_file")
    
    if [[ ${#env_list[@]} -eq 0 ]]; then
        echo -e "${RED}❌ No environments found for company: $company${NC}"
        echo -e "${YELLOW}💡 Expected profile format: ${company}_environment${NC}"
        return 1
    fi
    
    # Display menu
    local i=1
    local menu_temp
    menu_temp=$(mktemp -t aws_env_menu.XXXXXX)
    
    echo -e "${BLUE}Available Environments for ${company_upper}:${NC}"
    for env in "${env_list[@]}"; do
        env_emoji=$(get_env_icon "$env")
        profile_name="${company}_${env}"
        account_id=$(get_account_id "$profile_name" "$config_file")
        env_upper=$(to_uppercase "$env")
        
        printf "${GREEN}%2d)${NC} ${env_emoji} ${BLUE}%-12s${NC} ${MAGENTA}(%s)${NC} ${CYAN}%s${NC}\n" \
            "$i" "${env_upper}" "$profile_name" "${account_id:-N/A}"
        
        # Store mapping in temp file
        echo "$i:$env" >> "$menu_temp"
        ((i++))
    done
    
    echo ""
    echo -e "${CYAN}💡 Tip: Use ${BOLD}aws_profile ${company} ENVIRONMENT${NC}${CYAN} to jump directly to profile details${NC}"
    echo ""
    printf "${GREEN}%2s)${NC} ${YELLOW}%-12s${NC}\n" "b" "← Back to Companies"
    printf "${GREEN}%2s)${NC} ${RED}%-12s${NC}\n" "q" "Quit"
    echo ""
    
    # Get user selection
    while true; do
        echo -n -e "${YELLOW}👉 Enter your choice [1-$((i-1)), b, or q]: ${NC}"
        read -r choice
        
        if [[ "$choice" == "q" || "$choice" == "Q" ]]; then
            rm -f "$menu_temp"
            echo "👋 Goodbye!"
            return 0
        elif [[ "$choice" == "b" || "$choice" == "B" ]]; then
            rm -f "$menu_temp"
            show_company_menu "$config_file"
            return 0
        elif [[ "$choice" =~ ^[0-9]+$ ]] && [[ $choice -ge 1 ]] && [[ $choice -lt $i ]]; then
            # Get environment from temp file
            selected_env=$(grep "^$choice:" "$menu_temp" | cut -d: -f2)
            rm -f "$menu_temp"
            if [[ -n "$selected_env" ]]; then
                selected_profile="${company}_${selected_env}"
                show_profile_details "$company" "$selected_env" "$selected_profile" "$config_file"
                return 0
            fi
        else
            echo -e "${RED}❌ Invalid choice. Please try again.${NC}"
        fi
    done
}

# Function to display final profile details and commands
show_profile_details() {
    local company="$1"
    local environment="$2"
    local profile="$3"
    local config_file="${4:-${HOME}/.aws/config}"
    
    clear_screen
    echo -e "${CYAN}╔════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║    AWS SSO Profile Manager    ║${NC}"
    echo -e "${CYAN}║         macOS Compatible           ║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════╝${NC}"
    echo ""
    
    env_emoji=$(get_env_icon "$environment")
    company_upper=$(to_uppercase "$company")
    environment_upper=$(to_uppercase "$environment")
    
    echo -e "${BLUE}🏢 Company: ${BOLD}${company_upper}${NC}"
    echo -e "${GREEN}${env_emoji} Environment: ${BOLD}${environment_upper}${NC}"
    echo -e "${MAGENTA}📋 Profile: ${BOLD}${profile}${NC}"
    echo ""
    
    # Check if profile exists and get configuration
    local profile_config=""
    local in_profile=false
    local config_found=false
    
    while IFS= read -r line; do
        if [[ $line =~ ^\[profile[[:space:]]+$profile\] ]]; then
            in_profile=true
            config_found=true
            profile_config+="$line"$'\n'
        elif [[ $line =~ ^\[ ]]; then
            in_profile=false
        elif [[ $in_profile == true ]] && [[ $line =~ ^[a-zA-Z] ]]; then
            profile_config+="$line"$'\n'
        fi
    done < "$config_file"
    
    if [[ $config_found == false ]]; then
        echo -e "${RED}❌ Profile '$profile' not found in config file!${NC}"
        return 1
    fi
    
    # Parse and display configuration in a structured way
    show_structured_config "$profile" "$profile_config"
    
    # Show usage commands
    aws sso login --profile $profile --use-device-code
    
}

# Function to show structured configuration
show_structured_config() {
    local profile="$1"
    local config="$2"
    
    echo -e "${YELLOW}⚙️  SSO Configuration:${NC}"
    echo "$(printf '═%.0s' $(seq 1 19))"
    echo ""
    
    # Parse configuration values
    local sso_start_url=""
    local sso_region=""
    local sso_account_id=""
    local sso_role_name=""
    local output=""
    
    while IFS= read -r line; do
        if [[ $line =~ ^sso_start_url[[:space:]]*=[[:space:]]*(.+)$ ]]; then
            sso_start_url="${BASH_REMATCH[1]// /}"
        elif [[ $line =~ ^sso_region[[:space:]]*=[[:space:]]*(.+)$ ]]; then
            sso_region="${BASH_REMATCH[1]// /}"
        elif [[ $line =~ ^sso_account_id[[:space:]]*=[[:space:]]*(.+)$ ]]; then
            sso_account_id="${BASH_REMATCH[1]// /}"
        elif [[ $line =~ ^sso_role_name[[:space:]]*=[[:space:]]*(.+)$ ]]; then
            sso_role_name="${BASH_REMATCH[1]// /}"
        elif [[ $line =~ ^output[[:space:]]*=[[:space:]]*(.+)$ ]]; then
            output="${BASH_REMATCH[1]// /}"
        fi
    done <<< "$config"
    
    # Display in a structured format
    echo -e "${BLUE}🔗 SSO Start URL:${NC}    ${GREEN}$sso_start_url${NC}"
    echo -e "${BLUE}🌍 SSO Region:${NC}       ${GREEN}$sso_region${NC}"
    echo -e "${BLUE}🏦 Account ID:${NC}       ${GREEN}$sso_account_id${NC}"
    echo -e "${BLUE}👤 Role Name:${NC}        ${GREEN}$sso_role_name${NC}"
    echo -e "${BLUE}📄 Output Format:${NC}    ${GREEN}$output${NC}"
    echo ""
}

# Function to copy to clipboard (macOS optimized)
copy_to_clipboard() {
    local text="$1"
    
    if command -v pbcopy >/dev/null 2>&1; then
        echo "$text" | pbcopy
        echo -e "${GREEN}✅ Copied to clipboard (macOS): $text${NC}"
    elif command -v xclip >/dev/null 2>&1; then
        echo "$text" | xclip -selection clipboard
        echo -e "${GREEN}✅ Copied to clipboard (Linux): $text${NC}"
    elif command -v clip >/dev/null 2>&1; then
        echo "$text" | clip
        echo -e "${GREEN}✅ Copied to clipboard (Windows): $text${NC}"
    else
        echo -e "${YELLOW}⚠️  Clipboard utility not found.${NC}"
        echo -e "${BLUE}Command: ${text}${NC}"
        echo -e "${YELLOW}💡 On macOS, pbcopy should be available by default${NC}"
    fi
}

